---
const { slug, url } = Astro.props;
---

<div id="disqus_thread" data-slug={slug} data-url={url}></div>
<script is:inline>
  function disqus_config() {
    const thread = document.getElementById("disqus_thread");
    this.page.url = thread.dataset.url; // Use the passed URL from Astro
    this.page.identifier = thread.dataset.slug; // Use the passed slug as the unique identifier
  }

  const d = document,
    s = d.createElement("script");
  s.src = "https://irregular-25.disqus.com/embed.js"; // Replace with your Disqus shortname URL
  s.setAttribute("data-timestamp", (+new Date()).toString());
  (d.head || d.body).appendChild(s);
</script>
